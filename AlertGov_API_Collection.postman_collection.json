                        "name": "Obtain Token",
                        "request": {
                            "method": "POST",
                            "header": [{
                                "key": "Content-Type",
                                "value": "application/json"
                            }],
                            "body": {
                                "mode": "raw",
                                "raw": "{\n  \"username\": \"dispatcher\",\n  \"password\": \"DispatcherPass123!\"\n}"
                            },
                            "url": {
                                "raw": "{{base_url}}/api/token/",
